# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase SESSION pooler (port 5432 on *.pooler.supabase.com), not the transaction pooler (6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Redis broker for Celery (docker-compose service `redis`).
REDIS_URL=redis://localhost:6379/0

# Local test database (docker-compose service db-test, published on host port 5433). Safe placeholder values; this DB holds no real data.
TEST_DATABASE_URL=postgres://ledger:ledger@localhost:5433/ledger_test

# Email for dues reminders. Leave these out and emails are printed to the console instead.
# For real sending, set them in the environment of the machine that runs the app. Never commit them.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Society Ledger <reminders@your-domain.example>

# Demo mode: one-click passwordless logins for the listed users. NEVER on a real database.
DEMO_MODE=False
DEMO_USERS=vikram,asha,tara,ravi,nisha
