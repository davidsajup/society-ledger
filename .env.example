# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase SESSION pooler (port 5432 on *.pooler.supabase.com), not the transaction pooler (6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local test database (docker-compose service db-test). Safe placeholder values; this DB holds no real data.
TEST_DATABASE_URL=postgres://ledger:ledger@db-test:5432/ledger_test
